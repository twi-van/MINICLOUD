# Copy to .env.local for real API + Keycloak through the running gateway.
# Use mock for both DATA_SOURCE and AUTH_MODE for an offline demo.
VITE_DATA_SOURCE=api

# Used only when VITE_DATA_SOURCE=api. Restart Vite / rebuild Docker after edits.
# /api is proxied to localhost:8085 during Vite development.
# An absolute URL works too when the backend enables CORS.
VITE_API_BASE_URL=/api

VITE_AUTH_MODE=keycloak
VITE_KEYCLOAK_URL=http://localhost/auth
VITE_KEYCLOAK_REALM=minicloud
VITE_KEYCLOAK_CLIENT_ID=web-frontend

# Nginx runtime upstream for standalone Docker (not a browser URL).
# In the full stack use application-backend-server-1:8081.
BACKEND_UPSTREAM=host.docker.internal:8085
